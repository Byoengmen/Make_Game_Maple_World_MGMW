@Component
script WaveManager extends Component

	property integer TOTAL_WAVES = 10

	property number PREP_TIME = 10.0

	property integer currentWave = 0

	property boolean isWaveActive = false

	property boolean isPrepPhase = false

	property number prepTimer = 0.0

	property integer aliveCount = 0

	@ExecSpace("ServerOnly")
	method void OnBeginPlay()
		    -- 게임 시작 시 첫 웨이브 시작
		    log("WaveManager 시작")
		    self:StartWave()
	end

	@ExecSpace("ServerOnly")
	method void OnUpdate(number delta)
		    -- 정비 단계일 때 타이머 카운트다운
		    if self.isPrepPhase then
		        self.prepTimer = self.prepTimer - delta
		        if self.prepTimer <= 0 then
		            self.isPrepPhase = false
		            self:StartWave()
		        end
		    end
	end

	@ExecSpace("ServerOnly")
	method void StartWave()
		    self.currentWave = self.currentWave + 1
		    self.isWaveActive = true
		    self.aliveCount = 0             
		    log("Wave " .. self.currentWave .. " 시작")
	end

	@ExecSpace("ServerOnly")
	method void OnWaveClear()
		    -- 웨이브 클리어 시 호출
		    self.isWaveActive = false
		    log("Wave " .. self.currentWave .. " 클리어")
		
		    if self.currentWave >= self.TOTAL_WAVES then
		        log("게임 클리어!")
		    else
		        self.isPrepPhase = true
		        self.prepTimer = self.PREP_TIME
		        log("정비 시간 시작: " .. self.PREP_TIME .. "초")
		    end
	end

	@ExecSpace("ServerOnly")
	method void OnAdventurerSpawned()
		    -- 모험가 스폰될 때마다 호출
		    self.aliveCount = self.aliveCount + 1
	end

	@ExecSpace("ServerOnly")
	method void OnAdventurerDead()
		    -- 모험가 사망할 때마다 호출
		    self.aliveCount = self.aliveCount - 1
		    log("남은 모험가: " .. self.aliveCount)
		
		    if self.isWaveActive and self.aliveCount <= 0 then
		        self:OnWaveClear()
		    end
	end

end